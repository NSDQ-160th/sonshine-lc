---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { beliefs } from '../data/beliefs';
import { breadcrumbJsonLd } from '../data/schema';

const description =
  'What SonShine Learning Center believes. The same statement of faith as Calvary Chapel Frederick: God, Bible, man, and the Church.';
---

<Base
  title="What We Believe | SonShine Learning Center"
  description={description}
  current="beliefs"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Beliefs', path: '/beliefs/' },
  ])}
>
  <PageBanner
    title="What we believe"
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Beliefs', path: '/beliefs/' },
    ]}
  />
  <article class="page-body prose">
    <p class="lead">
      SonShine teaches from the same statement of faith as Calvary Chapel Frederick.
    </p>
    {
      beliefs.map((item) => (
        <section>
          <h2>{item.heading}</h2>
          <p>{item.body}</p>
        </section>
      ))
    }
  </article>
</Base>
