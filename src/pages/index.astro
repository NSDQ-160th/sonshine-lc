---
import FaqList from '../components/FaqList.astro';
import Base from '../layouts/Base.astro';
import { center, mailHref, mapsUrl, nap } from '../data/center';
import { faqJsonLd } from '../data/schema';
import { siteFaqs } from '../data/faq';

const description = `${center.name} is a Christian preschool ministry of ${center.church.name} in downtown Frederick, MD. ${center.program.ages}; ${center.program.days}; mornings 9:00–12:00.`;
---

<Base
  title="SonShine Learning Center | Christian Preschool in Frederick, MD"
  description={description}
  current="home"
  jsonLd={faqJsonLd(siteFaqs)}
>
  <section class="hero" data-hero>
    <img
      src="/images/classroom.jpg"
      alt="Children in class at SonShine Learning Center in downtown Frederick"
      width="2500"
      height="2223"
    />
    <div class="hero__copy wrap enter">
      <p class="meta">A preschool ministry of {center.church.name}</p>
      <p class="hero__kicker">As a Christ-centered preschool, we pursue</p>
      <h1>
        Quality education
        <span>and <em>tender care</em></span>
        <span class="hero__with">with Christian families</span>
      </h1>
      <a class="btn btn--arrow hero__cta" href="/enroll/">Explore admissions</a>
    </div>
  </section>

  <section class="mission" id="mission">
    <div class="wrap mission__grid">
      <p class="mission__since">Since <em>{center.established}</em></p>
      <div>
        <h2>Our purpose</h2>
        <p>{center.purpose}</p>
        <a class="btn btn--arrow" href="/enroll/">Begin enrollment</a>
      </div>
    </div>
  </section>

  <section class="faith">
    <div class="faith__photo">
      <img
        src="/images/teachers/mhairi.jpg"
        alt="Mhairi Lewis, director of SonShine Learning Center"
        width="800"
        height="1000"
      />
    </div>
    <div class="faith__copy">
      <p class="meta">Built upon</p>
      <h2>the promise of <em>God’s Word</em></h2>
      <blockquote class="scripture">
        {center.scripture.text}
        <cite>{center.scripture.ref}</cite>
      </blockquote>
      <p>{center.mission}</p>
      <a class="btn btn--arrow" href="/beliefs/">What we believe</a>
    </div>
  </section>

  <section class="divisions wrap">
    <header class="divisions__head">
      <p class="meta">A typical year</p>
      <h2>For our littlest learners</h2>
    </header>
    <div class="divisions__grid">
      <a class="card" href="/enroll/">
        <img src="/images/classroom.jpg" alt="" width="1200" height="900" />
        <div class="card__copy">
          <h3>Admissions</h3>
          <p class="meta">{center.program.ages}</p>
          <p>Handbook, forms, and published fees for the three-day morning program.</p>
          <span class="btn btn--arrow">Learn more</span>
        </div>
      </a>
      <a class="card" href="/schedule/">
        <img src="/images/classroom.jpg" alt="" width="1200" height="900" />
        <div class="card__copy">
          <h3>A morning</h3>
          <p class="meta">9:00–12:00</p>
          <p>Prayer, worship, Bible story, Let’s Learn, snack, and discovery time.</p>
          <span class="btn btn--arrow">See the schedule</span>
        </div>
      </a>
      <a class="card" href="/teachers/">
        <img
          src="/images/teachers/kathy.jpg"
          alt=""
          width="800"
          height="1000"
        />
        <div class="card__copy">
          <h3>Faculty</h3>
          <p class="meta">Director &amp; assistant</p>
          <p>Mrs. Mhairi Lewis and Mrs. Kathy Miller welcome children each class day.</p>
          <span class="btn btn--arrow">Meet the teachers</span>
        </div>
      </a>
    </div>
  </section>

  <section class="glance">
    <div class="wrap">
      <p class="meta">At a glance</p>
      <h2>{center.name}</h2>
      <ul>
        <li>
          <strong>{center.established}</strong>
          <span>Year founded</span>
        </li>
        <li>
          <strong>3–4</strong>
          <span>Ages served</span>
        </li>
        <li>
          <strong>M / W / F</strong>
          <span>Class days</span>
        </li>
        <li>
          <strong>9–12</strong>
          <span>Morning hours</span>
        </li>
        <li>
          <strong>MSDE</strong>
          <span>Accredited, religious-exempt</span>
        </li>
        <li>
          <strong>
            <a href={mapsUrl} rel="noreferrer">Downtown</a>
          </strong>
          <span>{nap}</span>
        </li>
      </ul>
      <a class="btn btn--arrow glance__mail" href={mailHref}>Email Mrs. Mhairi</a>
    </div>
  </section>

  <FaqList />
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    color: var(--white);
    display: grid;
    align-items: end;
  }

  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(0 45 82 / 0.25) 0%, rgb(0 45 82 / 0.72) 100%);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    padding: 8rem 0 var(--space-16);
    max-width: 46rem;
  }

  .hero__kicker {
    margin: var(--space-6) 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    font-weight: 500;
    margin-bottom: var(--space-8);
  }

  .hero h1 em {
    font-style: italic;
  }

  .hero__with {
    font-size: var(--step-2);
    font-weight: 400;
    margin-top: var(--space-2);
  }

  .hero__cta {
    color: var(--white);
  }

  .mission {
    background: var(--white);
    padding: var(--space-16) 0;
  }

  .mission__grid {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .mission__since {
    font-family: var(--font-ui);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--navy);
  }

  .mission__since em {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-4);
    letter-spacing: 0;
    text-transform: none;
    color: var(--navy-deep);
    line-height: 1;
    margin-top: var(--space-2);
  }

  .mission h2 {
    margin-bottom: var(--space-4);
  }

  .mission p {
    max-width: 38rem;
    margin-bottom: var(--space-6);
  }

  .faith {
    display: grid;
    background: var(--navy-deep);
    color: var(--cream);
  }

  .faith__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 22rem;
  }

  .faith__copy {
    padding: var(--space-12) var(--page-margin);
  }

  .faith h2 {
    margin: var(--space-3) 0 var(--space-6);
  }

  .faith h2 em {
    font-style: italic;
    display: block;
  }

  .faith .scripture {
    color: var(--taupe);
    margin-bottom: var(--space-6);
  }

  .faith .scripture cite {
    display: block;
    margin-top: var(--space-2);
    font-style: normal;
    font-family: var(--font-ui);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .faith p {
    max-width: 36rem;
    margin-bottom: var(--space-6);
  }

  .divisions {
    padding: var(--space-16) 0;
  }

  .divisions__head {
    margin-bottom: var(--space-10);
    max-width: 28rem;
  }

  .divisions__head h2 {
    margin-top: var(--space-3);
  }

  .divisions__grid {
    display: grid;
    gap: var(--space-6);
  }

  .card {
    display: grid;
    text-decoration: none;
    color: inherit;
    background: var(--white);
    min-height: 22rem;
    position: relative;
    overflow: hidden;
  }

  .card img {
    width: 100%;
    height: 16rem;
    object-fit: cover;
  }

  .card__copy {
    padding: var(--space-6);
  }

  .card h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    margin: var(--space-2) 0 var(--space-3);
  }

  .card p {
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
  }

  .card :global(.btn--arrow) {
    color: var(--navy);
    padding: 0;
  }

  .glance {
    background: var(--navy);
    color: var(--white);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .glance h2 {
    margin: var(--space-3) 0 var(--space-12);
    font-style: italic;
  }

  .glance ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-10);
  }

  .glance strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    font-style: italic;
  }

  .glance span {
    display: block;
    margin-top: var(--space-2);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .glance__mail {
    margin-top: var(--space-12);
    color: var(--white);
  }

  @media (min-width: 800px) {
    .mission__grid {
      grid-template-columns: 0.7fr 1.3fr;
    }

    .faith {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .faith__copy {
      padding: var(--space-16);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .divisions__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .glance ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
