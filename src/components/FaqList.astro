---
import { siteFaqs, type Faq } from '../data/faq';

interface Props {
  faqs?: Faq[];
}

const { faqs = siteFaqs } = Astro.props;
---

<section class="faq" id="faq">
  <div class="wrap">
    <p class="meta">Parents ask</p>
    <h2>Clear answers</h2>
    <dl>
      {
        faqs.map((item) => (
          <div>
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .faq {
    padding: var(--space-16) 0;
    background: var(--white);
  }

  .faq h2 {
    margin: var(--space-3) 0 var(--space-10);
    font-style: italic;
  }

  dl {
    display: grid;
    gap: var(--space-8);
    margin: 0;
  }

  dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: var(--space-2);
  }

  dd {
    margin: 0;
    color: var(--ink-soft);
    max-width: 42rem;
  }

  @media (min-width: 800px) {
    dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
