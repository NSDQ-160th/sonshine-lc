---
import FaqList from '../components/FaqList.astro';
import Base from '../layouts/Base.astro';
import { center, mailHref, mapsUrl, nap, telHref } from '../data/center';
import { faqJsonLd } from '../data/schema';
import { siteFaqs } from '../data/faq';

const description = `${center.name} is a Christian preschool ministry of ${center.church.name} in downtown Frederick, MD. ${center.program.ages}; ${center.program.days}; mornings 9:00–12:00.`;
---

<Base
  title="SonShine Learning Center | Christian Preschool in Frederick, MD"
  description={description}
  current="home"
  jsonLd={faqJsonLd(siteFaqs)}
>
  <section class="hero" data-hero>
    <img
      src="/images/classroom.jpg"
      alt="Children in class at SonShine Learning Center in downtown Frederick"
      width="2500"
      height="2223"
    />
    <div class="hero__copy wrap enter">
      <p class="meta">Preschool ministry of {center.church.name}</p>
      <h1>SonShine Learning Center</h1>
      <p class="lead">
        Quality education and tender care, with Christian character from a Biblical
        perspective. Downtown Frederick.
      </p>
      <p class="hero__facts">
        {center.program.ages} · {center.program.daysShort} · 9:00 AM–12:00 PM
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--xl" href="/enroll/">See enrollment</a>
        <a class="btn btn--secondary btn--xl" href={mailHref}>Email Mrs. Mhairi</a>
      </div>
    </div>
  </section>

  <section class="band wrap enter">
    <article>
      <p class="meta">Mornings</p>
      <h2>Three days a week</h2>
      <p>
        Arrival 8:45 AM. Class 9:00–11:45 AM. Dismissal 12:00 PM. {center.program.days}.
      </p>
    </article>
    <article>
      <p class="meta">Place</p>
      <h2>Same church building</h2>
      <p>
        <a href={mapsUrl} rel="noreferrer">{nap}</a>. Call
        <a href={telHref}>{center.phoneDisplay}</a>.
      </p>
    </article>
    <article>
      <p class="meta">Since {center.established}</p>
      <h2>A ministry, not a chain</h2>
      <p>
        SonShine is the preschool of {center.church.name}. Small by design, so the church
        can still use the building during the day.
      </p>
    </article>
  </section>

  <section class="story wrap">
    <div>
      <p class="meta">Why we exist</p>
      <h2>Purpose</h2>
      <p>{center.purpose}</p>
      <h2 class="story__next">Mission</h2>
      <p>{center.mission}</p>
      <blockquote class="scripture">
        {center.scripture.text}
        <cite>{center.scripture.ref}</cite>
      </blockquote>
    </div>
    <aside>
      <p class="meta">A typical morning</p>
      <ol>
        {
          center.day.map((row) => (
            <li>
              <span>{row.time}</span>
              {row.label}
            </li>
          ))
        }
      </ol>
      <a class="btn btn--secondary" href="/schedule/">Full calendar</a>
    </aside>
  </section>

  <section class="people wrap">
    <p class="meta">Who you’ll meet</p>
    <h2>Teachers</h2>
    <div class="people__grid">
      {
        center.teachers.map((t) => (
          <article>
            <img src={t.photo} alt={`${t.name}, ${t.role} at SonShine Learning Center`} />
            <h3>{t.name}</h3>
            <p class="meta">{t.role}</p>
            <p>{t.bio}</p>
          </article>
        ))
      }
    </div>
    <a class="btn btn--secondary" href="/teachers/">Meet the teachers</a>
  </section>

  <section class="fees wrap">
    <p class="meta">Published fees · {center.fees.asOf}</p>
    <h2>Affordable on purpose</h2>
    <p>
      Three-day program, {center.program.ages}. Confirm the
      <a href={center.fees.source}>current fees PDF</a> before paying. {center.fees.tuitionCheck}
    </p>
    <ul>
      <li><strong>{center.fees.monthly}</strong> monthly tuition</li>
      <li><strong>{center.fees.yearly}</strong> yearly ({center.fees.yearlyNote})</li>
      <li>Registration {center.fees.registrationFirst} first child, {center.fees.registrationAdditional} additional related child</li>
      <li>Curriculum / party / materials {center.fees.materials} per year</li>
    </ul>
    <a class="btn btn--primary" href="/enroll/">Enrollment packet</a>
  </section>

  <FaqList />
</Base>

<style>
  .hero {
    position: relative;
    min-height: 88dvh;
    color: var(--cream);
    display: grid;
    align-items: end;
  }

  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 48 64 / 0.15), rgb(10 48 64 / 0.78));
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    padding: 8rem 0 var(--space-14);
    max-width: 52rem;
  }

  .hero h1 {
    margin: var(--space-3) 0 var(--space-4);
  }

  .hero__facts {
    margin: var(--space-4) 0 var(--space-6);
    letter-spacing: 0.04em;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero :global(.btn--secondary) {
    color: var(--cream);
    border-color: var(--cream);
  }

  .hero :global(.btn--secondary:hover) {
    background: var(--cream);
    color: var(--forest-deep);
  }

  .band {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-12) 0;
  }

  .band h2 {
    font-size: var(--step-1);
    margin: var(--space-2) 0 var(--space-3);
  }

  .story,
  .people,
  .fees {
    padding: var(--space-12) 0;
  }

  .story {
    display: grid;
    gap: var(--space-10);
  }

  .story h2,
  .people h2,
  .fees h2 {
    margin: var(--space-2) 0 var(--space-4);
  }

  .story__next {
    margin-top: var(--space-8);
  }

  .scripture cite {
    display: block;
    margin-top: var(--space-2);
    font-style: normal;
    font-family: var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  .story ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-6);
  }

  .story li span {
    display: inline-block;
    width: 3.5rem;
    font-family: var(--font-display);
    letter-spacing: 0.08em;
    color: var(--forest);
  }

  .people__grid {
    display: grid;
    gap: var(--space-8);
    margin: var(--space-6) 0;
  }

  .people img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: var(--space-4);
  }

  .fees ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }

  @media (min-width: 800px) {
    .band {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .story {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: start;
    }

    .people__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
