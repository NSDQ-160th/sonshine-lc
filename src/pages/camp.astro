---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { center, mailHref } from '../data/center';
import { breadcrumbJsonLd } from '../data/schema';

const description = `SonShine Learning Center has offered morning Christian camp in Frederick, MD, for ${center.camp.ages}. Email ${center.email} for this year’s dates.`;
---

<Base
  title="Summer Camp | SonShine Learning Center"
  description={description}
  current="camp"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Summer camp', path: '/camp/' },
  ])}
>
  <PageBanner
    title="Summer camp"
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Summer camp', path: '/camp/' },
    ]}
  />
  <article class="page-body prose">
    <p class="lead">{center.camp.note}</p>
    <p>
      Last published shape: {center.camp.ages}, {center.camp.window}. Email
      <a href={mailHref}>{center.email}</a> and ask Mrs. Mhairi — we do not list old
      weeks as open registration.
    </p>
    <p>
      <a class="btn btn--primary" href={mailHref}>Ask about camp</a>
    </p>
  </article>
</Base>
