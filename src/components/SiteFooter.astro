---
import { center, mapsUrl, mailHref, nap, telHref } from '../data/center';
import Logo from './Logo.astro';
---

<footer class="foot">
  <nav class="foot__cta" aria-label="Get started">
    <div class="wrap foot__cta-row">
      <a href={mailHref}>Inquire</a>
      <a href="/enroll/">Enroll</a>
      <a href={center.church.url} rel="noreferrer">The church</a>
    </div>
  </nav>
  <div class="wrap foot__grid">
    <div>
      <p class="meta">Contact us</p>
      <p>
        <a href={mapsUrl} rel="noreferrer">{nap}</a>
      </p>
      <p><a href={telHref}>{center.phoneDisplay}</a></p>
      <p><a href={mailHref}>{center.email}</a></p>
      <p class="foot__hours">
        {center.program.daysShort}<br />
        9:00 AM–12:00 PM · {center.program.ages}
      </p>
    </div>
    <div class="foot__brand">
      <Logo stacked />
      <p class="foot__tag">{center.tagline}</p>
      <p>
        <a href={center.social.facebook} rel="noreferrer">Facebook</a>
      </p>
    </div>
    <div>
      <p class="meta">Parents</p>
      <ul>
        <li><a href="/enroll/">Admissions</a></li>
        <li><a href="/schedule/">Calendar</a></li>
        <li><a href="/teachers/">Faculty</a></li>
        <li><a href="/closings/">School closings</a></li>
        <li><a href="/camp/">Summer camp</a></li>
        <li><a href="/beliefs/">What we believe</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap foot__fine">
    Christian preschool in downtown Frederick, MD. Preview site — not yet live at sonshinelc.com.
  </p>
</footer>

<style>
  .foot {
    margin-top: auto;
    background: var(--navy-deep);
    color: var(--cream);
  }

  .foot a {
    color: inherit;
    text-decoration: none;
  }

  .foot a:hover {
    text-decoration: underline;
  }

  .foot__cta {
    background: var(--navy);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .foot__cta-row {
    display: grid;
    grid-template-columns: 1fr;
    text-align: center;
  }

  .foot__cta a {
    padding: 1.15rem 1rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .foot__grid {
    display: grid;
    gap: var(--space-10);
    padding: var(--space-14) 0 var(--space-10);
  }

  .foot .meta {
    color: var(--taupe);
    margin-bottom: var(--space-4);
  }

  .foot__hours {
    margin-top: var(--space-4);
    opacity: 0.85;
  }

  .foot__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .foot__tag {
    font-family: var(--font-display);
    font-style: italic;
    max-width: 22ch;
  }

  .foot ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .foot__fine {
    padding-bottom: var(--space-8);
    font-size: var(--step--1);
    opacity: 0.65;
    text-align: center;
  }

  @media (min-width: 800px) {
    .foot__cta-row {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .foot__cta a {
      border-bottom: 0;
      border-right: 1px solid rgb(255 255 255 / 0.12);
    }

    .foot__cta a:last-child {
      border-right: 0;
    }

    .foot__grid {
      grid-template-columns: 1fr 1.1fr 0.9fr;
      align-items: start;
    }
  }
</style>
