---
import { center, mailHref } from '../data/center';
import Logo from './Logo.astro';

interface Props {
  current?: 'home' | 'enroll' | 'schedule' | 'teachers' | 'beliefs' | 'closings' | 'camp';
  solid?: boolean;
}

const { current, solid = false } = Astro.props;

const links = [
  { href: '/enroll/', id: 'enroll', label: 'Admissions' },
  { href: '/schedule/', id: 'schedule', label: 'Schedule' },
  { href: '/teachers/', id: 'teachers', label: 'Faculty' },
  { href: '/beliefs/', id: 'beliefs', label: 'Beliefs' },
  { href: '/closings/', id: 'closings', label: 'Families' },
] as const;
---

<header class:list={['header', { 'is-solid': solid }]} data-header>
  <div class="header__utility">
    <div class="wrap header__utility-inner">
      <a href={center.church.url} rel="noreferrer">The church</a>
      <a href={mailHref}>Contact</a>
      <a href={center.social.facebook} rel="noreferrer">Facebook</a>
    </div>
  </div>
  <div class="header__bar wrap">
    <Logo />
    <nav class="header__nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn--primary header__cta" href="/enroll/">Enroll</a>
    <button
      class="header__toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="header__bun"></span>
      <span class="header__bun"></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>
  <div class="sheet" id="site-menu" data-menu hidden>
    <nav class="sheet__nav" aria-label="Mobile">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a href="/camp/">Summer camp</a>
      <a href={center.church.url} rel="noreferrer">Calvary Chapel Frederick</a>
      <a class="btn btn--primary" href="/enroll/">Enroll</a>
    </nav>
  </div>
</header>

<script>
  import '../scripts/header.ts';
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    color: var(--white);
    background: transparent;
    transition:
      background-color var(--duration-enter) var(--ease-enter),
      color var(--duration-enter) var(--ease-enter),
      box-shadow var(--duration-enter) var(--ease-enter);
  }

  .header__utility {
    display: none;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }

  .header__utility-inner {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-6);
    min-height: 2.25rem;
    align-items: center;
  }

  .header__utility a {
    text-decoration: none;
    opacity: 0.85;
  }

  .header.is-solid {
    background: var(--white);
    color: var(--navy-deep);
    box-shadow: 0 1px 0 var(--rule);
  }

  .header.is-solid .header__utility {
    border-bottom-color: var(--rule);
    color: var(--navy);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 4.5rem;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: var(--space-7, 1.75rem);
    margin-left: auto;
  }

  .header__nav a {
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .header__nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 currentColor;
  }

  .header__cta {
    display: none;
  }

  .header:not(.is-solid) :global(.btn--primary) {
    background: var(--white);
    color: var(--navy-deep);
    border-color: var(--white);
  }

  .header.is-solid :global(.btn--primary) {
    background: var(--navy);
    color: var(--white);
    border-color: var(--navy);
  }

  .header__toggle {
    margin-left: auto;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 7px;
    cursor: pointer;
  }

  .header__bun {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
  }

  .sheet {
    background: var(--navy-deep);
    color: var(--cream);
    padding: var(--space-6) var(--page-margin) var(--space-12);
  }

  .sheet__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sheet__nav a:not(.btn) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .sheet :global(.btn--primary) {
    align-self: flex-start;
    margin-top: var(--space-4);
    background: var(--white);
    color: var(--navy-deep);
    border-color: var(--white);
  }

  @media (min-width: 960px) {
    .header__utility,
    .header__nav,
    .header__cta {
      display: flex;
    }

    .header__toggle,
    .sheet {
      display: none;
    }

    .header__bar {
      min-height: 5.25rem;
    }
  }
</style>
