---
import { center } from '../data/center';

interface Props {
  stacked?: boolean;
}

const { stacked = false } = Astro.props;
---

<a class:list={['logo', { 'logo--stacked': stacked }]} href="/" aria-label={center.name}>
  <span class="logo__mark">
    <img src="/images/logo.jpg" alt="" width="56" height="43" />
  </span>
  <span class="logo__word">
    <span class="logo__line">SonShine</span>
    <span class="logo__place">Learning Center</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
  }

  .logo__mark {
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--white);
    flex-shrink: 0;
  }

  .logo__mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo__word {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .logo__line {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
  }

  .logo__place {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    opacity: 0.8;
  }

  .logo--stacked {
    flex-direction: column;
    text-align: center;
    gap: 0.35rem;
  }

  .logo--stacked .logo__mark {
    width: 56px;
    height: 56px;
  }
</style>
