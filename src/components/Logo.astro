---
import { center } from '../data/center';

interface Props {
  inverse?: boolean;
}

const { inverse = false } = Astro.props;
---

<a class:list={['logo', { 'logo--inverse': inverse }]} href="/" aria-label={center.name}>
  <span class="logo__mark">
    <img src="/images/logo.jpg" alt="" width="56" height="43" />
  </span>
  <span class="logo__word">
    <span class="logo__line">SonShine</span>
    <span class="logo__place">Learning Center</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
  }

  .logo__mark {
    width: 52px;
    height: 40px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--cream);
  }

  .logo__mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo__word {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .logo__line {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .logo__place {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
</style>
